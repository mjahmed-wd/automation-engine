{
  "name": "debug-and-automation-wxt",
  "description": "A simple Chrome extension with a sidebar built using WXT",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "wxt build && playwright test",
    "test:e2e:ui": "wxt build && playwright test --ui",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "json5": "^2.2.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/ui": "^2.1.8",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "wxt": "0.19.16"
  }
}
