{
  "name": "Paylowpro: Fill Contact (multi-step)",
  "description": "Navigate, fill three fields, then verify by reading one back.",
  "tag": "action",
  "variables": {
    "firstName": "Md.",
    "lastName":  "Jubair",
    "email":     "jubair@paylowpro.com"
  },
  "steps": [
    { "action": "goto", "url": "https://www.paylowpro.com/" },
    { "action": "fill", "selector": "input[type='text']", "nearText": "First Name", "value": "{{firstName}}" },
    { "action": "fill", "selector": "input[type='text']", "nearText": "Last Name",  "value": "{{lastName}}" },
    { "action": "fill", "selector": "input[type='text']", "nearText": "Email",      "value": "{{email}}" },
    { "action": "wait", "ms": 250 },
    { "action": "get",  "selector": "input[type='text']", "nearText": "Email", "saveAs": "verifiedEmail" }
  ]
}