{
  "name": "Paylowpro: Fill Contact (multi-step)",
  "description": "Navigate, fill three fields, then verify by reading one back.",
  "tag": "action",
  "variables": {
    "firstName": "Md.",
    "lastName": "Jubair",
    "email": "jubair@paylowpro.com"
  },
  "steps": [
    { "action": "goto", "url": "https://www.paylowpro.com/" },
    { "action": "fill", "xpath": "//label[contains(., 'First Name')]/following::input[1]", "value": "{{firstName}}" },
    { "action": "fill", "xpath": "//label[contains(., 'Last Name')]/following::input[1]",  "value": "{{lastName}}" },
    { "action": "fill", "xpath": "//*[@id='Email-arialabel']",                              "value": "{{email}}" },
    { "action": "wait", "ms": 250 },
    { "action": "get",  "xpath": "//*[@id='Email-arialabel']",                              "saveAs": "verifiedEmail" }
  ]
}
